# Root compose configuration — copy to .env and fill in real values.
# Never commit the real .env.

# --- JWT (required) ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# --- PostgreSQL (compose service "db") ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=expense_tracker

# --- Backend ---
# CORS origins allowed by the API (comma separated). Must match the origin
# the browser uses to reach the frontend.
CORS_ORIGINS=http://localhost:3000
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Frontend ---
# Baked into the client bundle at BUILD time. Must be reachable from the
# host browser, e.g. http://localhost:8000/api/v1 for local Docker.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
