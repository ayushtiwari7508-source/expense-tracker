# --- Application ---
APP_NAME=Expense Tracker API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/expense_tracker
DB_ECHO=false

# --- JWT ---
JWT_SECRET_KEY=replace-with-a-secure-secret-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS (comma separated) ---
CORS_ORIGINS=http://localhost:3000

# --- Testing (dedicated PostgreSQL test database) ---
# Create it once with:
#   docker exec expense-tracker-db psql -U postgres -c "CREATE DATABASE expense_tracker_test;"
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/expense_tracker_test
# Fallback (no PostgreSQL needed, reduced fidelity):
# TEST_DATABASE_URL=sqlite+aiosqlite:///./test.db
